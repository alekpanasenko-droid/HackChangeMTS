# Для Yandex AI Studio: значения из вашего локального .env
# YC_API_KEY=
# YC_FOLDER_ID=

# Альтернатива: OpenAI API
# Ключ проекта: https://platform.openai.com/api-keys
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Альтернатива: локальная Qwen / прокси организаторов с OpenAI-совместимым API
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=

# Опционально: готовый индекс из исходного RAG (требует BAAI/bge-m3)
# RAG_INDEX=MGTS_hackathon-main/rag/artifacts/index.zip
